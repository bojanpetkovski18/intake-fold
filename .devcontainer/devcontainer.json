{
  // Runs the Docker demo in GitHub Codespaces, or locally with the dev container CLI (D-081).
  "name": "Intakefold demo",
  "image": "mcr.microsoft.com/devcontainers/base:2-bookworm@sha256:99f5250dd2d5f8b11046d5662dd94c1e3c1dae56b560c7caad5ceb7edf349046",
  "features": {
    // docker-in-docker 4.1.3. The Docker engine and Compose it installs are its own latest.
    "ghcr.io/devcontainers/features/docker-in-docker@sha256:fae40f3c8be5a7c3b0db344c1d30341bc2c91ba38d1d5b14cd2ad72e6d65d084": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8180, 8190],
  "portsAttributes": {
    "8180": { "label": "Intakefold", "onAutoForward": "openBrowser" },
    "8190": { "label": "Webhook sink", "onAutoForward": "silent" },
    "5441": { "onAutoForward": "ignore" }
  }
}
