# Copy to .env for local work. Placeholders only: never put real secrets in this file.

# Compose
POSTGRES_USER=intakefold
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=intakefold
POSTGRES_HOST_PORT=5441

# Backend (required)
DATABASE_URL=postgresql+psycopg://intakefold:change-me-local-only@127.0.0.1:5441/intakefold

# Backend (optional)
ENVIRONMENT=development
LOG_LEVEL=INFO
SESSION_TTL_HOURS=12
SIGN_IN_RATE_LIMIT=10/minute
# Comma-separated. Vite's dev server is on 5173, the Compose web container on 8180.
ALLOWED_ORIGINS=http://127.0.0.1:8180,http://localhost:5173
# Comma-separated CIDR ranges. Leave empty unless the API sits behind a proxy.
TRUSTED_PROXIES=
# Sends the session cookie over plain http. Only for a browser on this machine.
ALLOW_INSECURE_COOKIES=false

# Needed by the seed. Fictional accounts, at least 12 characters.
DEMO_REVIEWER_PASSWORD=change-me-reviewer-local-only
DEMO_ADMIN_PASSWORD=change-me-admin-local-only
