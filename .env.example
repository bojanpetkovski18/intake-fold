# Copy to .env for local work. Placeholders only: never put real secrets in this file.

# Compose
POSTGRES_USER=intakefold
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=intakefold
POSTGRES_HOST_PORT=5441

# Backend (required)
DATABASE_URL=postgresql+psycopg://intakefold:change-me-local-only@127.0.0.1:5441/intakefold

# Backend (optional)
ENVIRONMENT=development
LOG_LEVEL=INFO
